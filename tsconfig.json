{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "esnext",
        "target": "esnext",
        "types": ["vite/client", "node"],
        "moduleResolution": "bundler",
        "lib": ["es2017", "dom"],
        "allowUnreachableCode": false,
        "allowUnusedLabels": false,
        "declaration": true,
        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "esModuleInterop": true,
        "checkJs": true,
        "jsx": "preserve",
        "resolveJsonModule": true
    },
    "include": ["resources/js/**/*", "resources/domains/tickets/components/TicketsOverview.vue", "resources/domains/tickets/pages/TicketDetailPage.vue", "resources/domains/tickets/components/TicketDetails.vue", "resources/domains/tickets/types.ts"]
}